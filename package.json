{
  "name": "css-variables-vscode",
  "displayName": "CSS Variables (LSP)",
  "description": "Project-wide CSS variable autocomplete, hover, go-to-definition and color support via css-variable-lsp.",
  "version": "0.3.7",
  "publisher": "miclmn451",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmn451/css-variables-vscode"
  },
  "keywords": [
    "css",
    "variables",
    "custom properties",
    "autocomplete",
    "intellisense",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11",
      "onFail": "error"
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:postcss",
    "onLanguage:ripple"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "CSS Variables (LSP)",
      "properties": {
        "cssVariables.lookupFiles": {
          "type": "array",
          "default": [
            "**/*.less",
            "**/*.scss",
            "**/*.sass",
            "**/*.css",
            "**/*.html",
            "**/*.vue",
            "**/*.svelte",
            "**/*.astro",
            "**/*.ripple"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to scan for CSS variables. Replaces the defaults."
        },
        "cssVariables.blacklistFolders": {
          "type": "array",
          "default": [
            "**/.cache/**",
            "**/.DS_Store",
            "**/.git/**",
            "**/.hg/**",
            "**/.next/**",
            "**/.svn/**",
            "**/bower_components/**",
            "**/CVS/**",
            "**/dist/**",
            "**/node_modules/**",
            "**/tests/**",
            "**/tmp/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to exclude from scanning. Replaces the defaults."
        },
        "cssVariables.colorOnlyVariables": {
          "type": "boolean",
          "default": true,
          "description": "Show color decorations only on var(--...) usages."
        },
        "cssVariables.noColorPreview": {
          "type": "boolean",
          "default": false,
          "description": "Disable color decorations entirely."
        },
        "cssVariables.pathDisplay": {
          "type": "string",
          "enum": [
            "relative",
            "absolute",
            "abbreviated"
          ],
          "default": "relative",
          "description": "Controls how definition paths are displayed in hover/completion details."
        },
        "cssVariables.pathDisplayLength": {
          "type": "number",
          "minimum": 0,
          "default": 1,
          "description": "Segment length for abbreviated path display."
        },
        "cssVariables.undefinedVarFallback": {
          "type": "string",
          "enum": [
            "warning",
            "info",
            "off"
          ],
          "default": "warning",
          "description": "Fallback severity when hovering undefined CSS variables."
        },
        "cssVariables.serverImplementation": {
          "type": "string",
          "enum": [
            "auto",
            "rust",
            "typescript"
          ],
          "default": "auto",
          "description": "Server implementation. 'auto' tries Rust first, falls back to TypeScript. 'rust' or 'typescript' forces a specific implementation."
        },
        "cssVariables.serverBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to custom css-lsp-rust binary (overrides bundled binary). Only used when serverImplementation is 'auto' or 'rust'."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-extension",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package-extension": "node esbuild.js --production",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --runInBand",
    "lint": "eslint src",
    "format": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test:integration": "node ./test/runTest.js",
    "test:integration:minimum": "node ./test/runTest.js --minimum",
    "package": "vsce package",
    "download-binaries": "node scripts/download-binaries.js",
    "prepare": "husky"
  },
  "dependencies": {
    "css-variable-lsp": "1.0.22",
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "glob": "^14.0.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "css-variable-lsp": {
      "glob": "$glob"
    },
    "@jest/reporters": {
      "glob": "$glob"
    },
    "jest-config": {
      "glob": "$glob"
    },
    "jest-runtime": {
      "glob": "$glob"
    },
    "mocha": {
      "glob": "$glob",
      "minimatch": "11.0.5"
    },
    "test-exclude": {
      "glob": "$glob",
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "@vscode/vsce": {
      "minimatch": "11.0.5"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.21.2"
}
