{
  "name": "css-variables-vscode",
  "displayName": "CSS Variables (LSP)",
  "description": "Project-wide CSS variable autocomplete, hover, go-to-definition and color support via css-variable-lsp.",
  "version": "0.3.4",
  "publisher": "miclmn451",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmn451/css-variables-vscode"
  },
  "keywords": [
    "css",
    "variables",
    "custom properties",
    "autocomplete",
    "intellisense",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:postcss",
    "onLanguage:ripple"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "CSS Variables (LSP)",
      "properties": {
        "cssVariables.lookupFiles": {
          "type": "array",
          "default": [
            "**/*.less",
            "**/*.scss",
            "**/*.sass",
            "**/*.css",
            "**/*.html",
            "**/*.vue",
            "**/*.svelte",
            "**/*.astro",
            "**/*.ripple"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to scan for CSS variables. Replaces the defaults."
        },
        "cssVariables.blacklistFolders": {
          "type": "array",
          "default": [
            "**/.cache/**",
            "**/.DS_Store",
            "**/.git/**",
            "**/.hg/**",
            "**/.next/**",
            "**/.svn/**",
            "**/bower_components/**",
            "**/CVS/**",
            "**/dist/**",
            "**/node_modules/**",
            "**/tests/**",
            "**/tmp/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to exclude from scanning. Replaces the defaults."
        },
        "cssVariables.colorOnlyVariables": {
          "type": "boolean",
          "default": true,
          "description": "Show color decorations only on var(--...) usages."
        },
        "cssVariables.noColorPreview": {
          "type": "boolean",
          "default": false,
          "description": "Disable color decorations entirely."
        },
        "cssVariables.pathDisplay": {
          "type": "string",
          "enum": [
            "relative",
            "absolute",
            "abbreviated"
          ],
          "default": "relative",
          "description": "Controls how definition paths are displayed in hover/completion details."
        },
        "cssVariables.pathDisplayLength": {
          "type": "number",
          "minimum": 0,
          "default": 1,
          "description": "Segment length for abbreviated path display."
        },
        "cssVariables.undefinedVarFallback": {
          "type": "string",
          "enum": [
            "warning",
            "info",
            "off"
          ],
          "default": "warning",
          "description": "Fallback severity when hovering undefined CSS variables."
        },
        "cssVariables.serverImplementation": {
          "type": "string",
          "enum": [
            "auto",
            "rust",
            "typescript"
          ],
          "default": "auto",
          "description": "Server implementation. 'auto' tries Rust first, falls back to TypeScript. 'rust' or 'typescript' forces a specific implementation."
        },
        "cssVariables.serverBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to custom css-lsp-rust binary (overrides bundled binary). Only used when serverImplementation is 'auto' or 'rust'."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-extension",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package-extension": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --runInBand",
    "lint": "eslint 'src/**' --ext .ts",
    "format": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test:integration": "node ./test/runTest.js",
    "package": "vsce package",
    "download-binaries": "node scripts/download-binaries.js"
  },
  "dependencies": {
    "@vscode/test-electron": "^2.5.2",
    "css-variable-lsp": "^1.0.16",
    "glob": "^13.0.1",
    "mocha": "^11.7.5",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^18.14.6",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.60.0",
    "@typescript-eslint/parser": "^5.60.0",
    "@vscode/vsce": "3.7.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.46.0",
    "husky": "^8.0.3",
    "jest": "^29.6.1",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "prepare": "husky install",
  "packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40"
}
